# ====================================================================
# ccbox 環境變數
# ====================================================================
# 複製此檔為 .env 並填入實際值：
#   cp .env.example .env
# ====================================================================

# ── Claude API ───────────────────────────────────────────────────────
# Anthropic API Key（若不用 `claude login` 登入，可直接設定 API key）
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── 防火牆 ───────────────────────────────────────────────────────────
# 啟用 iptables 白名單防火牆（需搭配 docker-compose.yml 中的 cap_add）
# CCBOX_FIREWALL=true

# ── Claude Code 設定 ─────────────────────────────────────────────────
# 停用遙測
# DISABLE_AUTOUPDATER=1
# DISABLE_TELEMETRY=1

# ── Claude Model ─────────────────────────────────────────────────────
# 指定預設模型（預設為 sonnet）
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=16000
